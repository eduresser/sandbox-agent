FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends zip unzip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 65532 sandbox \
    && useradd -u 65532 -g 65532 -d /home/sandbox -m sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

COPY kernel/kernel_node.js /kernel/kernel_node.js
COPY client/client_node.js /client/client_node.js

WORKDIR /workspace
USER sandbox

CMD ["node", "/kernel/kernel_node.js"]
