FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        zip unzip \
        libpq5 \
        libxml2 \
        libxslt1.1 \
        libjpeg62-turbo \
        libpng16-16 \
        libwebp7 \
        libffi8 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir ipython \
    && groupadd -g 65532 sandbox \
    && useradd -u 65532 -g 65532 -d /home/sandbox -m sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

COPY kernel/kernel_python.py /kernel/kernel_python.py
COPY client/client_python.py /client/client_python.py

ENV PYTHONUSERBASE=/home/sandbox/.local
ENV PATH="/home/sandbox/.local/bin:${PATH}"

WORKDIR /workspace
USER sandbox

CMD ["python", "/kernel/kernel_python.py"]
