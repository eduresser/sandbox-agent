# LLM Configuration (provider-agnostic)
CHAT_MODEL=gpt-4o
CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_API_KEY=sk-...
CHAT_MODEL_BASE_URL=
CHAT_MODEL_SUPPORTS_VISION=

# Container Limits
CONTAINER_MEMORY_LIMIT=1024m
CONTAINER_CPU_QUOTA=50000
CONTAINER_PIDS_LIMIT=128
CONTAINER_TMPFS_SIZE=200m
CONTAINER_EXECUTION_TIMEOUT_SECONDS=30
CONTAINER_MAX_SESSIONS=5
CONTAINER_MAX_SESSIONS_PER_THREAD=3
CONTAINER_EXECUTE_AS_ROOT=False
CONTAINER_READ_ONLY_ROOTFS=False

# Session Lifecycle (GC)
SESSION_IDLE_TTL_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=7200
SESSION_GC_INTERVAL_SECONDS=60
SESSION_MAX_ACTIVE_THREADS=10

# Output Limits
MAX_STDOUT_CHARS=50000
MAX_STDERR_CHARS=20000
MAX_RESULT_CHARS=30000
MAX_TRACEBACK_CHARS=8000

# Storage
STORAGE_DIR=./storage
IMPORT_ALLOWED_DIRS=

# API
API_BASE_URL=http://127.0.0.1:8000

# Agent
MAX_ITERATIONS=100

# Aegra + Checkpointer (PostgreSQL)
AEGRA_CONFIG=langgraph.json
AUTH_TYPE=noop
POSTGRES_USER=sandbox_agent
POSTGRES_PASSWORD=sandbox_agent_secret
POSTGRES_DB=sandbox_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
