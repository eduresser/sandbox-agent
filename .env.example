# LLM Configuration (provider-agnostic)
CHAT_MODEL=gpt-4o
CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_API_KEY=sk-...
CHAT_MODEL_BASE_URL=
CHAT_MODEL_SUPPORTS_VISION=

# Security
CONTAINER_MEMORY_LIMIT=1024m
CONTAINER_CPU_QUOTA=50000
CONTAINER_PIDS_LIMIT=128
CONTAINER_TMPFS_SIZE=200m
EXECUTION_TIMEOUT_SECONDS=30
MAX_SESSIONS=5
TERMINAL_ROOT=False

# Output Limits
MAX_STDOUT_CHARS=50000
MAX_STDERR_CHARS=20000
MAX_RESULT_CHARS=30000
MAX_TRACEBACK_CHARS=8000

# Export
OUTPUT_DIR=./outputs

# Agent
MAX_ITERATIONS=100

# Aegra + Checkpointer (PostgreSQL)
AEGRA_CONFIG=langgraph.json
AUTH_TYPE=noop
POSTGRES_USER=sandbox_agent
POSTGRES_PASSWORD=sandbox_agent_secret
POSTGRES_DB=sandbox_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
